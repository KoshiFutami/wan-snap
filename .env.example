# Database (MySQL)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=wansnap
MYSQL_PASSWORD=wansnap
MYSQL_DATABASE=wansnap
DATABASE_URL=mysql://wansnap:wansnap@db:3306/wansnap

# Auth
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
