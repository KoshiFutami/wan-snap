# Database (MySQL)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=wansnap
MYSQL_PASSWORD=wansnap
MYSQL_DATABASE=wansnap
DATABASE_URL=mysql://wansnap:wansnap@db:3306/wansnap

# Auth
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MAIL_FROM=
AUTH_MAIL_REGION=ap-northeast-1
AUTH_MAIL_SES_ENDPOINT=

# Storage (S3 / MinIO)
# - 開発 (MinIO): STORAGE_ENDPOINT=http://minio:9000, STORAGE_PUBLIC_BASE_URL=http://localhost:9000/wan-snap, STORAGE_FORCE_PATH_STYLE=true
# - 本番 (S3 + CloudFront): STORAGE_ENDPOINT空, STORAGE_CDN_URL=https://xxxx.cloudfront.net
STORAGE_ENDPOINT=
STORAGE_BUCKET=wan-snap
STORAGE_REGION=ap-northeast-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=
STORAGE_PUBLIC_BASE_URL=
STORAGE_CDN_URL=

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://api:3001

# API CORS (comma-separated origins; empty means localhost in dev / *.vercel.app in production)
CORS_ORIGIN=
