generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  location    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dogs      Dog[]
  posts     Post[]
  likes     Like[]
  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")

  @@map("users")
}

model Dog {
  id            String    @id @default(uuid())
  name          String
  breed         String
  birthYear     Int?      @map("birth_year")
  weightKg      Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  neckCm        Decimal?  @map("neck_cm") @db.Decimal(5, 1)
  chestCm       Decimal?  @map("chest_cm") @db.Decimal(5, 1)
  backLengthCm  Decimal?  @map("back_length_cm") @db.Decimal(5, 1)
  coatColors    String[]  @map("coat_colors")
  photoUrl      String?   @map("photo_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @map("owner_id")

  posts Post[]

  @@map("dogs")
}

model Post {
  id        String   @id @default(uuid())
  imageUrl  String   @map("image_url")
  caption   String?
  tags      String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String @map("author_id")

  dog   Dog    @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId String @map("dog_id")

  items PostItem[]
  likes Like[]

  @@map("posts")
}

model PostItem {
  id          String  @id @default(uuid())
  category    String
  brand       String?
  productName String? @map("product_name")
  size        String?
  purchaseUrl String? @map("purchase_url")
  priceJpy    Int?    @map("price_jpy")
  fitNote     String? @map("fit_note")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  @@map("post_items")
}

model Like {
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  @@id([userId, postId])
  @@map("likes")
}

model Follow {
  createdAt DateTime @default(now()) @map("created_at")

  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String @map("follower_id")

  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String @map("following_id")

  @@id([followerId, followingId])
  @@map("follows")
}
