generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique @db.VarChar(255)
  password    String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(100)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(512)
  bio         String?  @db.Text
  location    String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dogs      Dog[]
  posts     Post[]
  likes     Like[]
  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")

  @@map("users")
}

model Dog {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(50)
  breed        String   @db.VarChar(100)
  birthYear    Int?     @map("birth_year")
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  neckCm       Decimal? @map("neck_cm") @db.Decimal(5, 1)
  chestCm      Decimal? @map("chest_cm") @db.Decimal(5, 1)
  backLengthCm Decimal? @map("back_length_cm") @db.Decimal(5, 1)
  // JSON配列で保存: ["black", "white"] など
  coatColors   Json     @map("coat_colors")
  photoUrl     String?  @map("photo_url") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @map("owner_id")

  posts Post[]

  @@map("dogs")
}

model Post {
  id        String   @id @default(uuid())
  imageUrl  String   @map("image_url") @db.VarChar(512)
  caption   String?  @db.Text
  // JSON配列で保存: ["柴犬", "ハーネス"] など
  tags      Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String @map("author_id")

  dog   Dog    @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId String @map("dog_id")

  items PostItem[]
  likes Like[]

  @@map("posts")
}

model PostItem {
  id          String  @id @default(uuid())
  category    String  @db.VarChar(50)
  brand       String? @db.VarChar(100)
  productName String? @map("product_name") @db.VarChar(200)
  size        String? @db.VarChar(20)
  purchaseUrl String? @map("purchase_url") @db.VarChar(512)
  priceJpy    Int?    @map("price_jpy")
  fitNote     String? @map("fit_note") @db.VarChar(500)

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  @@map("post_items")
}

model Like {
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  @@id([userId, postId])
  @@map("likes")
}

model Breed {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("breeds")
}

model Follow {
  createdAt DateTime @default(now()) @map("created_at")

  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String @map("follower_id")

  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String @map("following_id")

  @@id([followerId, followingId])
  @@map("follows")
}
