generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique @db.VarChar(255)
  password    String   @db.VarChar(255)
  username    String   @unique @db.VarChar(30)
  displayName String   @map("display_name") @db.VarChar(100)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(512)
  bio                 String?  @db.Text
  location            String?  @db.VarChar(100)
  instagramUsername   String?  @map("instagram_username") @db.VarChar(30)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  dogs                  Dog[]
  posts                 Post[]
  likes                 Like[]
  bookmarks             Bookmark[]
  comments              Comment[]
  followers             Follow[]         @relation("Following")
  following             Follow[]         @relation("Follower")
  receivedNotifications Notification[]   @relation("ReceivedNotifications")
  sentNotifications     Notification[]   @relation("SentNotifications")

  @@map("users")
}

model Dog {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(50)
  birthYear    Int?     @map("birth_year")
  birthMonth   Int?     @map("birth_month")
  birthDay     Int?     @map("birth_day")
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  neckCm       Decimal? @map("neck_cm") @db.Decimal(5, 1)
  chestCm      Decimal? @map("chest_cm") @db.Decimal(5, 1)
  backLengthCm Decimal? @map("back_length_cm") @db.Decimal(5, 1)
  // JSON配列で保存: ["black", "white"] など
  coatColors   Json     @map("coat_colors")
  gender       String?  @db.VarChar(10)
  bio          String?  @db.Text
  instagramUsername String? @map("instagram_username") @db.VarChar(30)
  photoUrl     String?  @map("photo_url") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @map("owner_id")

  breed   Breed  @relation(fields: [breedId], references: [id], onDelete: Restrict)
  breedId String @map("breed_id")

  posts Post[]

  @@map("dogs")
}

model Post {
  id              String   @id @default(uuid())
  imageUrl        String   @map("image_url") @db.VarChar(512)
  imageWidth      Int?     @map("image_width")
  imageHeight     Int?     @map("image_height")
  caption         String?  @db.Text
  location        String?  @db.VarChar(100)
  dogWeightKg     Decimal? @map("dog_weight_kg") @db.Decimal(5, 2)
  dogNeckCm       Decimal? @map("dog_neck_cm") @db.Decimal(5, 1)
  dogChestCm      Decimal? @map("dog_chest_cm") @db.Decimal(5, 1)
  dogBackLengthCm Decimal? @map("dog_back_length_cm") @db.Decimal(5, 1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String @map("author_id")

  dog   Dog    @relation(fields: [dogId], references: [id], onDelete: Cascade)
  dogId String @map("dog_id")

  items         PostItem[]
  postTags      PostTag[]
  grooming      PostGrooming?
  likes         Like[]
  bookmarks     Bookmark[]
  comments      Comment[]
  notifications Notification[]

  @@map("posts")
}

// TODO(phase-c): salon_id カラムを追加して GroomingSalon マスタに紐づける
//  - GroomingSalon モデルを別集約として追加する（name, instagram_handle, address?）
//  - salon_id は nullable とし、null の場合は salon_name フリーテキストにフォールバック
//  - 既存データは salon_name をキーに正規化マイグレーションで移行する
model PostGrooming {
  postId         String  @id @map("post_id")
  salonName      String  @map("salon_name") @db.VarChar(100)
  salonInstagram String? @map("salon_instagram") @db.VarChar(100)
  cutStyle       String? @map("cut_style") @db.VarChar(100)
  note           String? @db.VarChar(500)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_groomings")
}

model PostTag {
  postId    String   @map("post_id")
  tag       String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, tag])
  @@index([tag])
  @@index([tag, postId])
  @@map("post_tags")
}

model Comment {
  id        String   @id @default(uuid())
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String @map("author_id")

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model PostItem {
  id          String  @id @default(uuid())
  category    String  @db.VarChar(50)
  brand       String? @db.VarChar(100)
  productName String? @map("product_name") @db.VarChar(200)
  size        String? @db.VarChar(20)
  purchaseUrl String? @map("purchase_url") @db.VarChar(512)
  priceJpy    Int?    @map("price_jpy")
  fitNote     String? @map("fit_note") @db.VarChar(500)
  xPct        Float?  @map("x_pct")
  yPct        Float?  @map("y_pct")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  @@map("post_items")
}

model Like {
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  @@id([userId, postId])
  @@map("likes")
}

model Breed {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  shortName String   @map("short_name") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  dogs Dog[]

  @@map("breeds")
}

model Follow {
  createdAt DateTime @default(now()) @map("created_at")

  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String @map("follower_id")

  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String @map("following_id")

  @@id([followerId, followingId])
  @@map("follows")
}

model Bookmark {
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  @@id([userId, postId])
  @@map("bookmarks")
}

model Notification {
  id        String   @id @default(uuid())
  type      String   @db.VarChar(20) // "like" | "comment" | "follow"
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  recipient   User   @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String @map("recipient_id")

  actor   User   @relation("SentNotifications", fields: [actorId], references: [id], onDelete: Cascade)
  actorId String @map("actor_id")

  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String? @map("post_id")

  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}
